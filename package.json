{
  "name": "cozi-api-client",
  "version": "1.0.0",
  "description": "Unofficial TypeScript/JavaScript client for Cozi Family Organizer API (reverse-engineered)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cozi": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "format": "prettier --write 'src/**/*.{js,ts}'"
  },
  "keywords": [
    "cozi",
    "family-organizer",
    "calendar",
    "todo",
    "shopping-list",
    "api-client",
    "typescript",
    "javascript",
    "reverse-engineered"
  ],
  "author": "BenHof",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BenHof/cozi-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/BenHof/cozi-api-client/issues"
  },
  "homepage": "https://github.com/BenHof/cozi-api-client#readme",
  "dependencies": {
    "axios": "^1.7.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "inquirer": "^8.2.7",
    "puppeteer": "^24.34.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.3",
    "@types/inquirer": "^8.2.12",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.7.4",
    "semantic-release": "^24.2.9",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.52.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
